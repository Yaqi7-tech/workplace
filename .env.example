# ============================================
# 职场 NPC 培训系统 API 配置
# ============================================
#
# 开源说明：本项目需要您自己配置 Dify API Keys
# 获取方式请查看 README.md
#
# 配置方式（任选其一）：
# 1. 将 API Keys 填入下方环境变量（开发者模式）
# 2. 在应用内的设置页面配置（推荐）
#
# ============================================

# NPC API（带教老师角色扮演）
VITE_NPC_API_URL=https://api.dify.ai/v1
VITE_NPC_API_KEY=

# Hint API（生成回复提示）
VITE_HINT_API_URL=https://api.dify.ai/v1
VITE_HINT_API_KEY=

# Supervisor API（社交督导评价）
VITE_SUPERVISOR_API_URL=https://api.dify.ai/v1
VITE_SUPERVISOR_API_KEY=

# 应用标题
VITE_APP_TITLE=职场培训系统
